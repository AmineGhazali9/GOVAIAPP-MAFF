# ============================================================
# GOVAIAPP-MAFF -- Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file with real secrets.
# ============================================================

# --- Azure AI Foundry ---
FOUNDRY_ENABLED=false
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project

# Agent IDs (Azure AI Foundry)
FOUNDRY_AGENT_VEILLE_EXTERNE_ID=your-agent-id-veille-externe
FOUNDRY_AGENT_RAG_ID=your-agent-id-rag
FOUNDRY_AGENT_PRODUCTEUR_ID=your-agent-id-producteur

# --- Azure AI Search (optional, for RAG) ---
# AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
# AZURE_SEARCH_API_KEY=your-search-api-key
# AZURE_SEARCH_INDEX_NAME=your-index-name
